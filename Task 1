<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Taskly – Mobile To-Do App</title>
<link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0d0f14;
    --surface: #161922;
    --surface2: #1e2230;
    --border: #2a2f3f;
    --accent: #7c6bff;
    --accent2: #ff6b9d;
    --accent3: #6bffd4;
    --text: #eef0f7;
    --text2: #8891aa;
    --text3: #555e78;
    --danger: #ff5c6a;
    --success: #4ade80;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: var(--bg);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    color: var(--text);
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(ellipse 600px 400px at 20% 10%, rgba(124,107,255,0.12) 0%, transparent 70%),
      radial-gradient(ellipse 400px 300px at 80% 80%, rgba(255,107,157,0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .scene {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 48px;
    align-items: flex-start;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* PHONE FRAME */
  .phone {
    width: 375px;
    height: 780px;
    background: var(--surface);
    border-radius: 48px;
    border: 2px solid var(--border);
    overflow: hidden;
    position: relative;
    box-shadow:
      0 0 0 8px #0a0c10,
      0 0 0 10px #1a1d26,
      0 40px 80px rgba(0,0,0,0.6),
      0 0 60px rgba(124,107,255,0.12);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  /* STATUS BAR */
  .statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 28px 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--text2);
    flex-shrink: 0;
  }
  .notch {
    width: 120px;
    height: 6px;
    background: #000;
    border-radius: 3px;
    margin: 0 auto 2px;
  }
  .status-icons { display: flex; gap: 5px; align-items: center; }
  .status-icons span { font-size: 14px; }

  /* SCREENS */
  .screen { position: absolute; inset: 0; display: flex; flex-direction: column; transition: transform 0.45s cubic-bezier(0.77,0,0.18,1), opacity 0.45s; }
  .screen.hidden { transform: translateX(100%); opacity: 0; pointer-events: none; }
  .screen.slide-left { transform: translateX(-100%); opacity: 0; pointer-events: none; }

  /* SCREEN 1: HOME */
  #screen-home {
    background: var(--surface);
    padding-top: 44px;
  }

  .home-header {
    padding: 0 28px 24px;
  }
  .greeting {
    font-family: 'Syne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .home-title {
    font-family: 'Syne', sans-serif;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
  }
  .home-title span { color: var(--accent); }

  .progress-ring-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 20px;
    padding: 16px 20px;
    background: var(--surface2);
    border-radius: 20px;
    border: 1px solid var(--border);
  }
  .ring-svg { width: 56px; height: 56px; transform: rotate(-90deg); }
  .ring-bg { fill: none; stroke: var(--border); stroke-width: 5; }
  .ring-fg { fill: none; stroke: var(--accent); stroke-width: 5; stroke-linecap: round; stroke-dasharray: 151; stroke-dashoffset: 60; transition: stroke-dashoffset 1s ease; }
  .ring-label { font-size: 14px; }
  .ring-label strong { display: block; font-size: 22px; font-family: 'Syne', sans-serif; font-weight: 700; color: var(--text); }
  .ring-label small { color: var(--text2); font-size: 12px; }

  /* CATEGORIES */
  .section-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--text3);
    padding: 0 28px;
    margin-bottom: 12px;
  }

  .categories {
    display: flex;
    gap: 12px;
    padding: 0 28px;
    margin-bottom: 24px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .categories::-webkit-scrollbar { display: none; }
  .cat-chip {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 16px;
    border-radius: 30px;
    border: 1px solid var(--border);
    background: var(--surface2);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition: all 0.2s;
    color: var(--text2);
  }
  .cat-chip.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .cat-dot { width: 8px; height: 8px; border-radius: 50%; }

  /* TASK LIST */
  .task-list { flex: 1; overflow-y: auto; padding: 0 20px 100px; scrollbar-width: none; }
  .task-list::-webkit-scrollbar { display: none; }

  .task-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--surface2);
    border-radius: 18px;
    border: 1px solid var(--border);
    margin-bottom: 10px;
    cursor: pointer;
    transition: all 0.2s;
    animation: fadeUp 0.4s ease both;
  }
  .task-item:nth-child(1) { animation-delay: 0.05s; }
  .task-item:nth-child(2) { animation-delay: 0.1s; }
  .task-item:nth-child(3) { animation-delay: 0.15s; }
  .task-item:nth-child(4) { animation-delay: 0.2s; }
  .task-item:nth-child(5) { animation-delay: 0.25s; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .task-item:active { transform: scale(0.98); }

  .check-btn {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 2px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all 0.2s;
    background: transparent;
    cursor: pointer;
    font-size: 14px;
  }
  .check-btn.done {
    background: var(--success);
    border-color: var(--success);
    color: #000;
  }

  .task-body { flex: 1; min-width: 0; }
  .task-title { font-size: 14px; font-weight: 500; color: var(--text); line-height: 1.3; }
  .task-title.done-text { text-decoration: line-through; color: var(--text3); }
  .task-meta { display: flex; gap: 8px; margin-top: 5px; align-items: center; }
  .tag { font-size: 11px; padding: 2px 8px; border-radius: 20px; font-weight: 500; }
  .tag-work { background: rgba(124,107,255,0.2); color: var(--accent); }
  .tag-personal { background: rgba(255,107,157,0.2); color: var(--accent2); }
  .tag-health { background: rgba(107,255,212,0.2); color: var(--accent3); }
  .task-time { font-size: 11px; color: var(--text3); }

  .priority-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
  .p-high { background: var(--danger); }
  .p-med { background: #f5a623; }
  .p-low { background: var(--success); }

  /* FAB */
  .fab {
    position: absolute;
    bottom: 90px;
    right: 28px;
    width: 60px; height: 60px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), #9b59ff);
    display: flex; align-items: center; justify-content: center;
    font-size: 28px;
    color: white;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(124,107,255,0.5);
    transition: transform 0.2s, box-shadow 0.2s;
    z-index: 10;
    border: none;
  }
  .fab:active { transform: scale(0.93); }

  /* BOTTOM NAV */
  .bottom-nav {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 80px;
    background: rgba(22,25,34,0.96);
    backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding-bottom: 16px;
    z-index: 5;
  }
  .nav-btn {
    display: flex; flex-direction: column; align-items: center; gap: 4px;
    color: var(--text3);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5px;
    cursor: pointer;
    transition: color 0.2s;
    background: none; border: none;
  }
  .nav-btn.active { color: var(--accent); }
  .nav-btn .icon { font-size: 22px; }

  /* SCREEN 2: ADD TASK */
  #screen-add {
    background: var(--bg);
    padding-top: 44px;
  }
  .sheet-header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 12px 24px 24px;
  }
  .sheet-title { font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 700; }
  .close-btn {
    width: 36px; height: 36px; border-radius: 50%;
    background: var(--surface2); border: 1px solid var(--border);
    font-size: 18px; display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: var(--text2); transition: all 0.2s;
  }
  .close-btn:active { transform: scale(0.92); }

  .form-section { padding: 0 24px; overflow-y: auto; flex: 1; }

  .field-label { font-size: 11px; font-weight: 600; letter-spacing: 1.5px; text-transform: uppercase; color: var(--text3); margin-bottom: 8px; }
  .field-group { margin-bottom: 20px; }

  .input-box {
    width: 100%;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px 18px;
    color: var(--text);
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s;
    resize: none;
  }
  .input-box:focus { border-color: var(--accent); }
  .input-box::placeholder { color: var(--text3); }

  .priority-row { display: flex; gap: 10px; }
  .priority-btn {
    flex: 1; padding: 11px; border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text2); font-size: 12px; font-weight: 600;
    cursor: pointer; transition: all 0.2s; text-align: center;
  }
  .priority-btn.sel-high { background: rgba(255,92,106,0.2); border-color: var(--danger); color: var(--danger); }
  .priority-btn.sel-med { background: rgba(245,166,35,0.2); border-color: #f5a623; color: #f5a623; }
  .priority-btn.sel-low { background: rgba(74,222,128,0.2); border-color: var(--success); color: var(--success); }

  .tag-row { display: flex; gap: 8px; flex-wrap: wrap; }
  .tag-btn {
    padding: 9px 16px; border-radius: 30px;
    border: 1px solid var(--border);
    background: var(--surface2);
    color: var(--text2); font-size: 13px; font-weight: 500;
    cursor: pointer; transition: all 0.2s;
  }
  .tag-btn.sel-work { background: rgba(124,107,255,0.2); border-color: var(--accent); color: var(--accent); }
  .tag-btn.sel-personal { background: rgba(255,107,157,0.2); border-color: var(--accent2); color: var(--accent2); }
  .tag-btn.sel-health { background: rgba(107,255,212,0.2); border-color: var(--accent3); color: var(--accent3); }

  .save-btn {
    width: calc(100% - 48px);
    margin: 20px 24px;
    padding: 18px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--accent), #9b59ff);
    color: #fff;
    font-family: 'Syne', sans-serif;
    font-size: 16px;
    font-weight: 700;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(124,107,255,0.4);
    transition: all 0.2s;
    letter-spacing: 0.5px;
  }
  .save-btn:active { transform: scale(0.97); opacity: 0.9; }

  /* SCREEN 3: DETAIL */
  #screen-detail {
    background: var(--bg);
    padding-top: 44px;
  }
  .detail-hero {
    padding: 0 24px 28px;
    border-bottom: 1px solid var(--border);
  }
  .detail-tag-row { display: flex; gap: 8px; margin-bottom: 14px; }
  .detail-title {
    font-family: 'Syne', sans-serif;
    font-size: 26px; font-weight: 800;
    line-height: 1.2;
    margin-bottom: 12px;
  }
  .detail-meta { display: flex; gap: 16px; }
  .meta-chip {
    display: flex; align-items: center; gap: 6px;
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 7px 12px;
    font-size: 12px; color: var(--text2);
  }

  .detail-body { padding: 24px; }
  .detail-notes {
    background: var(--surface2);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 18px;
    font-size: 14px; color: var(--text2);
    line-height: 1.7;
    margin-bottom: 24px;
  }

  .subtask-list { }
  .subtask { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); }
  .subtask:last-child { border-bottom: none; }
  .sub-check { width: 20px; height: 20px; border-radius: 6px; border: 2px solid var(--border); flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 12px; cursor: pointer; }
  .sub-check.done { background: var(--accent); border-color: var(--accent); color: white; }
  .sub-text { font-size: 14px; color: var(--text); }
  .sub-text.done { text-decoration: line-through; color: var(--text3); }

  /* BACK BTN */
  .back-btn {
    display: flex; align-items: center; gap: 6px;
    background: none; border: none; color: var(--accent);
    font-size: 14px; font-weight: 600; cursor: pointer;
    padding: 8px 0;
  }

  /* SIDEBAR INFO */
  .sidebar {
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .info-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 24px;
    padding: 20px;
  }
  .info-card h3 {
    font-family: 'Syne', sans-serif;
    font-size: 14px; font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 12px;
  }
  .info-card p {
    font-size: 13px;
    color: var(--text2);
    line-height: 1.6;
    margin-bottom: 10px;
  }
  .info-card p:last-child { margin-bottom: 0; }
  .flow-step {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--border);
    font-size: 13px;
    color: var(--text2);
  }
  .flow-step:last-child { border-bottom: none; }
  .step-num {
    width: 24px; height: 24px; border-radius: 50%;
    background: var(--accent);
    color: white; font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }

  .app-label {
    text-align: center;
    font-family: 'Syne', sans-serif;
    font-size: 20px; font-weight: 800;
    color: var(--text);
    letter-spacing: -0.5px;
  }
  .app-label span { color: var(--accent); }
  .app-sub { text-align: center; font-size: 12px; color: var(--text3); margin-top: 4px; }
</style>
</head>
<body>

<div class="scene">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div>
      <div class="app-label">Task<span>ly</span></div>
      <div class="app-sub">Mobile To-Do App UI Demo</div>
    </div>

    <div class="info-card">
      <h3>📱 App Concept</h3>
      <p>A sleek, dark-themed productivity app with category filtering, priority levels, and task detail views.</p>
      <p>Built as a simulation of a native mobile interface — navigate between the 3 screens using the buttons below the phone.</p>
    </div>

    <div class="info-card">
      <h3>🗺 Navigation Flow</h3>
      <div class="flow-step"><div class="step-num">1</div> Home — task list with progress</div>
      <div class="flow-step"><div class="step-num">2</div> Add Task — input form sheet</div>
      <div class="flow-step"><div class="step-num">3</div> Task Detail — full task view</div>
    </div>

    <div class="info-card">
      <h3>🎨 Design Choices</h3>
      <p><strong style="color:var(--text)">Colors:</strong> Deep navy + electric violet accent for a focused, night-mode feel.</p>
      <p><strong style="color:var(--text)">Type:</strong> Syne (headers) + DM Sans (body) for editorial clarity.</p>
      <p><strong style="color:var(--text)">UX:</strong> Category chips, priority dots, progress ring for at-a-glance info.</p>
    </div>

    <div class="info-card">
      <h3>⚡ Interactions</h3>
      <p>• Tap tasks to mark complete</p>
      <p>• Tap + FAB to go to Add screen</p>
      <p>• Tap a task row to see Detail</p>
      <p>• Use nav bar to switch screens</p>
    </div>
  </div>

  <!-- PHONE -->
  <div class="phone">

    <!-- STATUS BAR -->
    <div class="statusbar" style="position:absolute;top:0;left:0;right:0;z-index:20; background:var(--surface);">
      <span>9:41</span>
      <div class="status-icons">
        <span>●●●</span>
        <span>WiFi</span>
        <span>🔋</span>
      </div>
    </div>

    <!-- SCREEN 1: HOME -->
    <div class="screen" id="screen-home">
      <div style="height:44px;flex-shrink:0;"></div>

      <div class="home-header">
        <div class="greeting">Good Morning 👋</div>
        <div class="home-title">My <span>Tasks</span></div>

        <div class="progress-ring-wrap">
          <svg class="ring-svg" viewBox="0 0 54 54">
            <circle class="ring-bg" cx="27" cy="27" r="24"/>
            <circle class="ring-fg" cx="27" cy="27" r="24"/>
          </svg>
          <div class="ring-label">
            <strong>3/5</strong>
            <small>Tasks done today</small>
          </div>
          <div style="margin-left:auto;text-align:right;">
            <div style="font-size:22px;font-family:'Syne',sans-serif;font-weight:700;color:var(--text);">60%</div>
            <div style="font-size:11px;color:var(--text2);">Complete</div>
          </div>
        </div>
      </div>

      <div class="section-label">Categories</div>
      <div class="categories">
        <div class="cat-chip active"><div class="cat-dot" style="background:var(--accent)"></div>All</div>
        <div class="cat-chip"><div class="cat-dot" style="background:var(--accent)"></div>Work</div>
        <div class="cat-chip"><div class="cat-dot" style="background:var(--accent2)"></div>Personal</div>
        <div class="cat-chip"><div class="cat-dot" style="background:var(--accent3)"></div>Health</div>
      </div>

      <div class="section-label">Today</div>

      <div class="task-list" id="task-list">
        <div class="task-item" onclick="toggleCheck(this)" data-detail="1">
          <button class="check-btn done" onclick="event.stopPropagation();toggleCheck(this.parentElement)">✓</button>
          <div class="task-body">
            <div class="task-title done-text">Review design mockups</div>
            <div class="task-meta">
              <span class="tag tag-work">Work</span>
              <span class="task-time">9:00 AM</span>
            </div>
          </div>
          <div class="priority-dot p-high"></div>
        </div>

        <div class="task-item" onclick="goDetail()" data-detail="2">
          <button class="check-btn" onclick="event.stopPropagation();toggleCheck(this.parentElement)"></button>
          <div class="task-body">
            <div class="task-title">Prepare quarterly report</div>
            <div class="task-meta">
              <span class="tag tag-work">Work</span>
              <span class="task-time">11:00 AM</span>
            </div>
          </div>
          <div class="priority-dot p-high"></div>
        </div>

        <div class="task-item" onclick="toggleCheck(this)">
          <button class="check-btn done" onclick="event.stopPropagation();toggleCheck(this.parentElement)">✓</button>
          <div class="task-body">
            <div class="task-title done-text">Morning run – 5km</div>
            <div class="task-meta">
              <span class="tag tag-health">Health</span>
              <span class="task-time">7:00 AM</span>
            </div>
          </div>
          <div class="priority-dot p-med"></div>
        </div>

        <div class="task-item" onclick="toggleCheck(this)">
          <button class="check-btn" onclick="event.stopPropagation();toggleCheck(this.parentElement)"></button>
          <div class="task-body">
            <div class="task-title">Call dentist for appointment</div>
            <div class="task-meta">
              <span class="tag tag-personal">Personal</span>
              <span class="task-time">2:00 PM</span>
            </div>
          </div>
  
